# SDIS local development template
# This file is a TEMPLATE. Never commit or fill in real secrets.
# Startup validation rejects unknown SDIS_* keys and a malformed
# SDIS_API_TOKENS — see src/runtime/process.ts and docs/RUNBOOKS.md §1.

NODE_ENV=development

# ---- PostgreSQL (runtime connection; database.ts defaults shown) ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=sdis
PGUSER=postgres
# PGPASSWORD=            # supply locally; NEVER commit a real password

# ---- Authentication (AUTH-02 credential directory) ------------------------
# JSON array of credential bindings; ABSENT = fail-closed (every request 401).
# SDIS_API_TOKENS=[{"token":"...","userId":"...","organizationId":"<uuid v4>","facilityId":"<uuid v4>","roles":["viewer","operator","manager"]}]

# ---- Recovery tooling (backup / verify-restore / ops-check) ---------------
# SDIS_PG_CLIENT_DIR=C:/path/to/pg/bin

# ---- Transport ------------------------------------------------------------
# Body limit and /metrics exposure default; no environment key is read for
# these (TransportConfig at the composition edge).
