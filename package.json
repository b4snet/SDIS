{
  "name": "sdis",
  "version": "0.1.0",
  "private": true,
  "description": "Swasthya Diagnostic Information System — Step 1 foundation contracts (TypeScript)",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check src tests docs",
    "test": "node --test --test-concurrency=1 \"dist/tests/**/*.test.js\"",
    "verify": "npm run clean && npm run build && npm run typecheck && npm run lint && npm run format:check && npm test && npm audit --audit-level=high",
    "backup": "node scripts/sdis-admin.mjs backup",
    "verify-restore": "node scripts/sdis-admin.mjs verify-restore",
    "ops-check": "node scripts/sdis-admin.mjs check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.17.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "uuid": "^14.0.2"
  }
}
